{
  "compilerOptions": {
    
    "jsx": "react",
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"]  
  },

  "include": ["src/**/*"],
  
  "exclude": ["node_modules", "dist"]
}